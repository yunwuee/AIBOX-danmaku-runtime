{
  "name": "@yunwuee/aibox-danmaku-runtime",
  "version": "0.1.2",
  "private": true,
  "description": "AIBOX 内置 Node 使用的可审计弹幕运行时",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=18.20.4 <23"
  },
  "scripts": {
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "apply:sync-artifact": "node scripts/apply-sync-artifact.mjs",
    "build": "node scripts/build-runtime.mjs",
    "verify": "node scripts/verify-runtime.mjs",
    "test": "node --test --test-reporter=spec",
    "check": "npm run build && npm test && npm run verify"
  },
  "dependencies": {
    "brotli": "1.3.3",
    "node-fetch": "3.3.2",
    "opencc-js": "1.0.5",
    "pako": "2.1.0"
  },
  "devDependencies": {
    "es-module-lexer": "1.7.0",
    "esbuild": "0.28.1",
    "fflate": "0.8.2"
  }
}
